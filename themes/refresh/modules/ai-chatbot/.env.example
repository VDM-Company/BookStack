# AI Chatbot — configuration
#
# Copy the settings you need into your BookStack .env file (the one in the
# application root), then run `php artisan config:clear`.

# ---------------------------------------------------------------- required ---

# Your Anthropic API key, from https://console.anthropic.com/settings/keys
# Until this is set the module registers nothing at all: no routes, no widget.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- optional ---

# Master switch. Set to false to disable without removing the key.
AI_CHATBOT_ENABLED=true

# Model to use. claude-haiku-4-5 is the recommended default (cheaper, faster);
# claude-sonnet-5 balances quality and cost; claude-opus-5 reasons hardest.
AI_CHATBOT_MODEL=claude-haiku-4-5

# Longest reply the model may generate, in tokens.
AI_CHATBOT_MAX_TOKENS=1024

# Wall-clock budget for one question, in seconds, covering every wiki lookup
# the assistant makes along the way.
AI_CHATBOT_TIMEOUT=120

# How many turns the assistant may take per question. Each search or page read
# costs one turn, so this caps both latency and spend on a single question.
AI_CHATBOT_MAX_STEPS=6

# Results returned per search.
AI_CHATBOT_SEARCH_RESULTS=5

# Character ceiling on any single page handed to the model. Longer pages are
# truncated with a marker rather than dropped.
AI_CHATBOT_PAGE_CHARS=4000

# Prior messages replayed for conversational context.
AI_CHATBOT_HISTORY_TURNS=6

# Messages per user per minute. 0 disables the limit.
AI_CHATBOT_RATE_LIMIT=20

# Allow the guest user on a public instance to use the assistant. Off by
# default: guests pass BookStack's auth middleware, so enabling this lets
# anonymous visitors spend your API credits.
AI_CHATBOT_ALLOW_GUESTS=false

# Restrict access to specific roles, by role ID or display name.
# Empty means every logged-in user. Example: AI_CHATBOT_ROLES=Admin,Editors
AI_CHATBOT_ROLES=

# Extra instructions appended to the built-in system prompt. Useful for house
# tone, terminology, or pointing the assistant at authoritative books.
# AI_CHATBOT_SYSTEM_PROMPT="Prefer the Engineering Handbook over older notes. Always give the page name you took a figure from."

# Override the API endpoint, for a proxy or gateway. Rarely needed.
AI_CHATBOT_API_BASE=https://api.anthropic.com

# Chatbot failures (PHP exceptions and the browser "Something went wrong"
# banner) are sent to Sentry when the BookStack root .env has a DSN:
# SENTRY_LARAVEL_DSN=https://...@....ingest.de.sentry.io/...
